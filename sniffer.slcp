# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: sniffer
label: sniffer
description: |
  This example project shows an empty configuration that can be used as a starting point to add components and functionality.
category: Example|Platform
filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Beginner]
package: platform
quality: production
readme:
- {path: readme.md}
- {path: readme.md}
source:
- {path: app.c}
- {path: main.c}
include:
- path: .
  file_list:
  - {path: app.h}
sdk: {id: simplicity_sdk, version: 2024.12.1}
toolchain_settings: []
component:
- {id: EFR32MG24B310F1536IM48}
- {id: app_log}
- {id: brd2601b}
- {id: clock_manager}
- {id: device_init}
- instance: [co2]
  id: i2cspm
- {id: iostream_debug}
- {id: iostream_swo}
- {id: sl_system}
- instance: [lora, rpi]
  id: uartdrv_eusart
- instance: [so2]
  id: uartdrv_usart
define:
- {name: DEBUG_EFM}
ui_hints:
  highlight:
  - {path: readme.md, focus: true}

